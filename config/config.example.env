# AI 对话平台运行配置示例
# 用法：cp config/config.example.env .env && set -a && . ./.env && set +a
# 全部通过环境变量注入，便于容器化部署。

# ---- 服务 ----
AIP_HOST=0.0.0.0
AIP_PORT=8080
# 入站鉴权 token；留空表示不鉴权（仅限本地开发）
AIP_TOKEN=
# 内置 Web UI（/、/assets/*）。false = 纯 API 模式，不暴露页面。
AIP_WEB=true

# ---- 模型网关 ----
# mock = 离线假模型；openai = 任何 OpenAI 兼容接口
AIP_PROVIDER=mock

# DeepSeek（官方 OpenAI 兼容）
AIP_BASE_URL=https://api.deepseek.com/v1
AIP_MODEL=deepseek-chat
# 允许客户端请求的模型列表（逗号分隔）；默认只允许 AIP_MODEL。
# 需要多模型选择时在这里列出，/v1/models 会返回同样的列表。
# AIP_MODELS=deepseek-chat,deepseek-reasoner

# 通义千问（DashScope 兼容模式）示例：
# AIP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AIP_MODEL=qwen-plus

# 本地 vLLM / Ollama 示例：
# AIP_BASE_URL=http://127.0.0.1:8000/v1
# AIP_MODEL=Qwen2.5-7B-Instruct

# 只用 openai provider 时才需要；单 key 用 AIP_API_KEY，
# 多 key 用 AIP_API_KEYS（逗号分隔，按请求轮转，重试时自动换下一个）。
AIP_API_KEY=
# AIP_API_KEYS=sk-aaa,sk-bbb,sk-ccc

AIP_TIMEOUT_S=120
AIP_MAX_TOKENS=1024
AIP_TEMPERATURE=0.7
# 上游不支持 stream_options 时设为 false
AIP_INCLUDE_USAGE=true

# 上游失败重试：只发生在「还没吐出第一个 token」时，避免前端看到重复内容。
# 0 = 关闭；只对 408/409/425/429/5xx 和连接类 curl 错误重试。
AIP_MAX_RETRIES=2
# 指数退避基准（毫秒）：300 -> 600 -> 1200...，单次最多 5 秒，另加 <100ms 抖动。
AIP_RETRY_BASE_MS=300

# ---- 对话 ----
AIP_SYSTEM_PROMPT=你是一个乐于助人的 AI 助手，回答简洁准确。
AIP_MAX_HISTORY=20
# 模型上下文预算（token 估算）；必须大于 AIP_MAX_TOKENS
AIP_MAX_CONTEXT_TOKENS=8192
AIP_MAX_SESSIONS=10000

# ---- 持久化（阶段 3）----
# memory = 进程内 LRU（默认，重启即丢，适合演示/测试）
# postgres = 会话与消息落 PostgreSQL（生产）
AIP_STORAGE=memory
# storage=postgres 时必填；下面的默认值对应 docker compose 里的 postgres 服务
# AIP_DB_DSN=postgresql://aiplatform:aiplatform@127.0.0.1:55432/aiplatform?connect_timeout=5
AIP_DB_POOL_SIZE=8
AIP_DB_CONNECT_TIMEOUT_S=5

# ---- 用户鉴权（阶段 4）----
# false = 本地开发：未设置 AIP_TOKEN / AIP_JWT_SECRET 时对话接口匿名开放
# true  = 强制所有非公开接口鉴权（需要 AIP_TOKEN 或 AIP_JWT_SECRET）
AIP_AUTH_REQUIRED=false
# JWT 需要 AIP_STORAGE=postgres；生产必须设置 >=32 字节，且多副本一致：
#   openssl rand -hex 32
# Web 登录/注册需要同时设置本项和 AIP_STORAGE=postgres；否则页面回退到 Token 输入。
# AIP_JWT_SECRET=
AIP_JWT_ISSUER=aiplatform
# access token 15 分钟，refresh token 7 天
AIP_JWT_TTL_S=900
AIP_JWT_REFRESH_TTL_S=604800

# ---- 配额（阶段 4；0 = 不限）----
# 每用户每分钟请求数
AIP_RPM_LIMIT=60
# 每用户每日 token（按 usage_records 汇总；预留本次 max_tokens）
AIP_DAILY_TOKEN_LIMIT=1000000
# 每用户同时在途流
AIP_MAX_CONCURRENT_PER_USER=4
# request_id in_progress 超过该秒数视为崩溃，允许重试
AIP_IDEMPOTENCY_TTL_S=180

# ---- HTTP 层（Drogon 后端）----
# IO 线程数：0 = 按核数自动（2~8）。IO 线程只做 epoll + send，不用跟核数一一对应。
AIP_IO_THREADS=0
# 同时在途 SSE 流上限；超出直接返回 503 too_many_streams，避免上游请求堆积。
AIP_MAX_STREAMS=512
# SSE 心跳 / 断连探测周期（秒）。代价：客户端断开后最坏要一个周期才取消上游。
AIP_HEARTBEAT_S=15
# SIGTERM 后等待在途流收尾的最长时间（秒），超时才强制退出。
AIP_SHUTDOWN_DRAIN_S=30

# debug | info | warn | error
AIP_LOG_LEVEL=info
# text = 人类可读；json = 一行一个 JSON（生产建议）
AIP_LOG_FORMAT=json

# ---- 可观测性 ----
# Prometheus 指标端点 /metrics；生产建议只在内网暴露，或设置 Bearer Token。
AIP_METRICS_ENABLED=true
# 非空时 /metrics 需要 Authorization: Bearer <token>
# AIP_METRICS_TOKEN=
# 部署在 Nginx/LB 后时开启，登录限流等使用 X-Forwarded-For 的真实客户端 IP。
AIP_TRUST_PROXY=false
