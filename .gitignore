# ---- 构建产物 -----------------------------------------------------------
build/
.deps/
# build-poc / build-drogon / build-httplib 等
build-*/
cmake-build-*/
*.o
*.a
*.so
*.out

# ---- 运行时生成 ---------------------------------------------------------
