.env.*
!.env.example

# ---- Python（scripts/ 下的压测与假上游脚本） ---------------------------
__pycache__/
*.py[cod]
.venv/

# ---- 编辑器 / 系统 ------------------------------------------------------
.vscode/
.idea/
.DS_Store
