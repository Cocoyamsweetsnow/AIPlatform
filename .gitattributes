# 统一换行符：仓库内一律 LF，避免 Windows 同事 checkout 后整个仓库变成 CRLF。
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不要做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary

# 单头文件库：diff 时当作普通文本，但不要在 GitHub 上展开巨大的 diff
third_party/json.hpp     linguist-vendored
third_party/httplib.h    linguist-vendored
